APP_NAME=AI Content Factory
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db
JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ai-content-factory.local
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10
UPLOAD_DIR=storage/uploads
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=black-forest-labs/flux.2-klein-4b
POLLINATIONS_API_URL=https://gen.pollinations.ai/v1/images/generations
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
